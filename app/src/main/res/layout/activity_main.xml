<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lottie="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnimation"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_centerInParent="true"
        lottie:lottie_rawRes="@raw/splash_anim"
        lottie:lottie_autoPlay="true"
        lottie:lottie_loop="true"/>
    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌟 Kiddoji 🎈"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#4D96FF"

        android:layout_below="@id/lottieAnimation"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"

        android:shadowColor="#FF6F91"
        android:shadowRadius="12"
        android:shadowDx="0"
        android:shadowDy="0"/>


</RelativeLayout>