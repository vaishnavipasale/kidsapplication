<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/dashboardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ── HEADER ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="26dp">

                <TextView
                    android:id="@+id/topBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦  SEEKHO AUR MASTI KARO  ✦"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_badge_gradient"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chalo, Kya Seekhein?"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B2E"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ek category chuno aur shuru karo! 🚀"
                    android:textSize="13sp"
                    android:textColor="#6B677E"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- ── ROW 1: Letters + Days ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">

                <!-- Alphabetical Letter -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#FF6F61">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_c1">

                        <View
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_white_alpha"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="-24dp"
                            android:layout_marginBottom="-24dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="bottom">

                            <TextView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:text="🔤"
                                android:textSize="28sp"
                                android:gravity="center"
                                android:background="@drawable/rounded_white_alpha"
                                android:layout_marginBottom="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alphabetical\nLetter"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:lineSpacingMultiplier="1.15"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="A SE Z TAK"
                                android:textSize="10sp"
                                android:textColor="#FFCCC8"
                                android:textStyle="bold"
                                android:letterSpacing="0.15"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/button1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:text=""/>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Days of Week -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#5D4FD4">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_c2">

                        <View
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_white_alpha"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="-24dp"
                            android:layout_marginBottom="-24dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="bottom">

                            <TextView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:text="📅"
                                android:textSize="28sp"
                                android:gravity="center"
                                android:background="@drawable/rounded_white_alpha"
                                android:layout_marginBottom="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Days of\nWeek"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:lineSpacingMultiplier="1.15"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SOM SE RAVI TAK"
                                android:textSize="10sp"
                                android:textColor="#D0CAFF"
                                android:textStyle="bold"
                                android:letterSpacing="0.12"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/button2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:text=""/>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ── ROW 2: Months + Animal ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">

                <!-- Months of Year -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#1BA8A0">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_c3">

                        <View
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_white_alpha"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="-24dp"
                            android:layout_marginBottom="-24dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="bottom">

                            <TextView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:text="🗓️"
                                android:textSize="28sp"
                                android:gravity="center"
                                android:background="@drawable/rounded_white_alpha"
                                android:layout_marginBottom="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Months of\nYear"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:lineSpacingMultiplier="1.15"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JAN SE DEC TAK"
                                android:textSize="10sp"
                                android:textColor="#B8EFED"
                                android:textStyle="bold"
                                android:letterSpacing="0.12"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/button3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:text=""/>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Animal -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#F07800">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_c4">

                        <View
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_white_alpha"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="-24dp"
                            android:layout_marginBottom="-24dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="bottom">

                            <TextView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:text="🦁"
                                android:textSize="28sp"
                                android:gravity="center"
                                android:background="@drawable/rounded_white_alpha"
                                android:layout_marginBottom="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Animal"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JANWARON KI DUNIYA"
                                android:textSize="10sp"
                                android:textColor="#FFE0B0"
                                android:textStyle="bold"
                                android:letterSpacing="0.12"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/button4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:text=""/>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ── ROW 3: Fruits + Birds ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">

                <!-- Fruits -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#CC1035">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_c5">

                        <View
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_white_alpha"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="-24dp"
                            android:layout_marginBottom="-24dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="bottom">

                            <TextView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:text="🍎"
                                android:textSize="28sp"
                                android:gravity="center"
                                android:background="@drawable/rounded_white_alpha"
                                android:layout_marginBottom="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fruits"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MEETHE PHAL"
                                android:textSize="10sp"
                                android:textColor="#FFAABB"
                                android:textStyle="bold"
                                android:letterSpacing="0.12"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/button5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:text=""/>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Birds -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#D90E85">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_c6">

                        <View
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_white_alpha"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="-24dp"
                            android:layout_marginBottom="-24dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="bottom">

                            <TextView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:text="🦜"
                                android:textSize="28sp"
                                android:gravity="center"
                                android:background="@drawable/rounded_white_alpha"
                                android:layout_marginBottom="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Birds"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PYARI CHIDIYA"
                                android:textSize="10sp"
                                android:textColor="#FFB8E0"
                                android:textStyle="bold"
                                android:letterSpacing="0.1"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/button6"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:text=""/>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ── ROW 4: Vegetables (full width) ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dashboard_wide_card_height"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#27AE40">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_c7">

                    <View
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:background="@drawable/circle_white_alpha"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="-36dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="18dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:text="🥦"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:background="@drawable/rounded_white_alpha"
                            android:layout_marginEnd="18dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vegetables"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TAAZI SABZIYAN"
                                android:textSize="10sp"
                                android:textColor="#C8F5C8"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"/>

                        </LinearLayout>

                    </LinearLayout>

                    <Button
                        android:id="@+id/button7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:text=""/>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════ -->
            <!-- ── SECTION DIVIDER ── -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="18dp"
                android:layout_marginTop="4dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#22000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ✦  Kahani Aur Kavita  ✦  "
                    android:textSize="12sp"
                    android:textColor="#7B6FA0"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#22000000"/>

            </LinearLayout>

            <!-- ── ROW 5: Poems + Stories ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">

                <!-- Poems -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#7B4FA6">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_c8">

                        <View
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_white_alpha"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="-24dp"
                            android:layout_marginBottom="-24dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="bottom">

                            <TextView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:text="📜"
                                android:textSize="28sp"
                                android:gravity="center"
                                android:background="@drawable/rounded_white_alpha"
                                android:layout_marginBottom="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Poems"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GEET AUR KAVITA"
                                android:textSize="10sp"
                                android:textColor="#DFC8FF"
                                android:textStyle="bold"
                                android:letterSpacing="0.12"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/button8"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:text=""/>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Stories -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#C0652B">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_c9">

                        <View
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/circle_white_alpha"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="-24dp"
                            android:layout_marginBottom="-24dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="bottom">

                            <TextView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:text="📖"
                                android:textSize="28sp"
                                android:gravity="center"
                                android:background="@drawable/rounded_white_alpha"
                                android:layout_marginBottom="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stories"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KAHANIYAN AUR MASTI"
                                android:textSize="10sp"
                                android:textColor="#FFD8B8"
                                android:textStyle="bold"
                                android:letterSpacing="0.12"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/button9"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:text=""/>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ── ROW 6: Rhymes (full width) ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dashboard_wide_card_height"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#0A7DBF">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_c10">

                    <View
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:background="@drawable/circle_white_alpha"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="-36dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="18dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:text="🎵"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:background="@drawable/rounded_white_alpha"
                            android:layout_marginEnd="18dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
